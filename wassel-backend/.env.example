# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/wassel

# Required in production
JWT_SECRET=replace-with-a-long-random-secret

# Production frontend origin(s), comma-separated
ALLOWED_ORIGINS=https://wassel-project.vercel.app

# Optional pricing configuration
BASE_FEE_TND=3
PRICE_PER_KM_TND=0.8
MIN_FEE_TND=5
COMMISSION_RATE=0.15
